# =============================================================================
# IBVAP (Intelligent Border Video Analytics Platform) - Environment Config
# =============================================================================

# LLM Provider Configuration (Optional: defaults to gemini)
# Supported: gemini | openai_compatible | anthropic
LLM_PROVIDER="gemini"
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gemini-3.8-flash"
LLM_FAILOVER="true"

# Gemini Multimodal API Key (Optional)
# If omitted or invalid, the platform gracefully switches to the local grounded
# heuristic reasoning engine with full transparency badges in the UI.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Optional Provider-Specific Keys for Ordered Failover:
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Backend Access Control Token (Optional)
# Shared secret required in Authorization: Bearer <TOKEN> or x-api-key: <TOKEN>.
# If unset, strict same-origin browser request verification is enforced.
API_ACCESS_TOKEN=""

# Server Listening Port (Optional, defaults to 3000)
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV="development"

# App Deployment URL (Optional, for production / reverse proxies)
APP_URL="http://localhost:3000"

# Disable Vite HMR file watching in resource-constrained environments (Optional)
DISABLE_HMR="false"
