{
  "name": "ibvap-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "gateway"
  ],
  "scripts": {
    "setup": "node tools/setup.js",
    "demo": "node tools/demo-runner.js",
    "dev": "npm --workspace=gateway run dev",
    "dev:all": "node tools/dev-all.js",
    "stop": "node tools/stop-all.js",
    "build": "npm --workspace=frontend run build && npm --workspace=gateway run build",
    "build:frontend": "npm --workspace=frontend run build",
    "build:gateway": "npm --workspace=gateway run build",
    "start": "node tools/dev-all.js --prod",
    "prod": "node tools/dev-all.js --prod",
    "lint": "npm --workspace=frontend run lint && npm --workspace=gateway run lint",
    "lint:frontend": "npm --workspace=frontend run lint",
    "lint:gateway": "npm --workspace=gateway run lint",
    "test": "npm --workspace=frontend run test && npm --workspace=gateway run test",
    "test:frontend": "npm --workspace=frontend run test",
    "test:gateway": "npm --workspace=gateway run test"
  }
}
