# =============================================================================
# IBVAP AI Service (Python FastAPI) - Environment Config
# =============================================================================

PORT=8000
HOST=0.0.0.0

# Detection & Tracking Model
YOLO_MODEL=yolo26s.pt
CONF_THRESHOLD=0.35
IOU_THRESHOLD=0.45
DEVICE=auto

# Core Service Communication
CORE_SERVICE_URL=http://localhost:8080
SERVICE_TOKEN=ibvap-internal-secret-token-change-in-prod

# Feature Toggles
ENABLE_LOW_LIGHT_CLAHE=true
ENABLE_ANPR=true
