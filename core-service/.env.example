# =============================================================================
# IBVAP Core Service (Spring Boot 3) - Environment Config
# =============================================================================

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Internal Service-to-Service Secret
SERVICE_TOKEN=ibvap-internal-secret-token-change-in-prod

# JWT Secret & Expiration
JWT_SECRET=ibvap-super-secret-jwt-key-minimum-256-bits-for-hmac-sha-change-in-prod
JWT_EXPIRATION_MS=86400000

# Demo Credentials
DEMO_OPERATOR_USERNAME=operator
DEMO_OPERATOR_PASSWORD=OperatorPassword123!
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=AdminPassword123!

# Database Configuration (dev uses H2 in-memory; prod uses PostgreSQL)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ibvap
# SPRING_DATASOURCE_USERNAME=ibvap_user
# SPRING_DATASOURCE_PASSWORD=ibvap_password
