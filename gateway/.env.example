# =============================================================================
# IBVAP Gateway - Environment Config
# =============================================================================

PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Multimodal LLM Copilot Configuration (Provider-Agnostic)
# Supported LLM_PROVIDER: gemini | openai_compatible | anthropic (default: gemini)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gemini-3.8-flash
LLM_FAILOVER=true

# Gemini-specific backwards compatibility (works seamlessly when GEMINI_API_KEY is provided)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional Provider-Specific Keys for Ordered Failover:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Upstream Services
CORE_SERVICE_URL=http://localhost:8080
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_WS=ws://localhost:8000

# Shared Service Token for internal upstream communications
SERVICE_TOKEN=ibvap-internal-secret-token-change-in-prod

# Client API Access Token (Optional: defaults to same-origin verification)
API_ACCESS_TOKEN=
DISABLE_HMR=false
